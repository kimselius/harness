# Egress allowlist for the harness. Everything the agent sends outward has to
# pass through here, because its own network has no route anywhere else.
FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends tinyproxy \
    && rm -rf /var/lib/apt/lists/*
COPY tinyproxy.conf /etc/tinyproxy/tinyproxy.conf
COPY allowlist /etc/tinyproxy/allowlist
EXPOSE 3128
# Foreground, so the container's lifetime is the proxy's lifetime.
ENTRYPOINT ["tinyproxy", "-d", "-c", "/etc/tinyproxy/tinyproxy.conf"]
