# Copy to .env — the harness loads it automatically (real env vars win).

# chmod 600 this file. Better still, keep the key out of the environment with
# OPENAI_API_KEY_FILE=/run/secrets/openai-key (see the Security section).
OPENAI_API_KEY=sk-...
HARNESS_MODEL=gpt-4o-mini

# Any OpenAI-compatible endpoint works. Examples:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_BASE_URL=http://localhost:11434/v1        # ollama
# OPENAI_BASE_URL=http://localhost:8000/v1         # vllm / llama.cpp

# Context window. The default is a safe 32000; raise it to what your server
# really serves. Find out by sending an oversize prompt — a good endpoint says
# "prompt is N tokens, which does not fit the M token context", and M is your
# ceiling. Leave headroom: the reply shares the window, and a bigger prompt means
# a slower first token because the server prefills all of it.
#   ceiling 131072  ->  96000 is a comfortable setting (compacts at 72k)
# HARNESS_CONTEXT_TOKENS=32000
# HARNESS_COMPACT_AT=0.75          # compact at 75% of the window
# HARNESS_COMPACT_KEEP=0.25        # keep the newest 25% verbatim
# Compaction uses your main model by default. Only set this to use a different,
# usually cheaper/faster one for the summaries.
# HARNESS_SUMMARY_MODEL=qwen3.5:9b

# Thinking. On by default at medium. Values: minimal/low/medium/high, or off.
# Reasoning text is always logged; --show-thinking also prints it.
# HARNESS_REASONING_EFFORT=medium
# HARNESS_EXTRA_BODY={"top_k": 40}

# Optional limits
# HARNESS_WORKSPACE=workspace
# HARNESS_PROMPT_FILE=PROMPT.md
# HARNESS_LOG_DIR=logs
# HARNESS_MAX_OUTPUT_CHARS=6000
# HARNESS_MAX_OUTPUT_LINES=250
# HARNESS_SHELL_TIMEOUT=120
# HARNESS_MAX_SHELL_TIMEOUT=900
# HARNESS_MAX_STEPS=60 # default: 30

# Unattended runs (see the "Unattended runs" section of the README)
# HARNESS_MAX_SECONDS=900   # wall-clock limit per turn, 0 = none
# HARNESS_LABEL=nightly     # tags the run in --sessions and the result file
# HARNESS_RESULT_FILE=/tmp/harness-result.json

